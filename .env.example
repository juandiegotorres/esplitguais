# Copiar a .env (cp .env.example .env) y completar. .env NO se commitea.

# Clave secreta de Django: larga, aleatoria y privada. Generarla con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiame

# Siempre 0 en producción (1 solo para desarrollo local sin Docker).
DEBUG=0

# Dominio público por el que entra la app (separados por coma, sin esquema).
ALLOWED_HOSTS=gastos.practicomercio.com.ar

# Orígenes HTTPS confiables para CSRF (con esquema).
CSRF_TRUSTED_ORIGINS=https://gastos.practicomercio.com.ar

# HSTS: el navegador solo usará HTTPS para este subdominio durante un año.
# Dejar en 0 hasta confirmar que la app abre bien por HTTPS.
SECURE_HSTS_SECONDS=31536000

# Opcional: Django redirige HTTP→HTTPS. Innecesario si Cloudflare tiene "Always Use HTTPS".
# SECURE_SSL_REDIRECT=1

# Solo Docker: token del túnel (Cloudflare Zero Trust → Networks → Tunnels → gastos).
# Lo usa el servicio cloudflared de docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Solo cPanel: carpeta del docroot donde collectstatic deja los estáticos (LiteSpeed los
# sirve directo). scripts/deploy-cpanel.sh la agrega sola si falta.
# STATIC_ROOT=/home/USUARIO/gastos.practicomercio.com.ar/static
